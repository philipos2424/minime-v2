{
  "version": 2,
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node"
    },
    {
      "src": "public/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    { "src": "/assets/(.*)", "dest": "/public/assets/$1" },
    { "src": "/health(.*)", "dest": "server.js" },
    { "src": "/api(.*)", "dest": "server.js" },
    { "src": "/miniapp(.*)", "dest": "server.js" },
    { "src": "/webhook(.*)", "dest": "server.js" },
    { "src": "/(.*)", "dest": "/public/index.html" }
  ],
  "env": {
    "NODE_ENV": "production",
    "WEB_URL": "https://minime-v2-omega.vercel.app"
  },
  "crons": [
    {
      "path": "/api/cron/analytics",
      "schedule": "0 0 * * *"
    }
  ]
}
